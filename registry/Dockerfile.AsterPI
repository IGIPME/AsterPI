# syntax=docker/dockerfile:1

# ================= 构建阶段（Alpine，直接产出 musl 静态二进制） =================
FROM rust:1.98-alpine AS builder

RUN apk add --no-cache \
    build-base \
    perl \
    pkgconfig \
    openssl-dev \
    ca-certificates

RUN rustup target add wasm32-unknown-unknown \
    && rustup component add rust-src

ARG CARGO_LEPTOS_VERSION=0.3.7
RUN cargo install cargo-leptos --version ${CARGO_LEPTOS_VERSION} --locked

WORKDIR /build

# ---- 1) 先复制清单与所有 crate 的 Cargo.toml（缓存依赖，无需源码） ----
COPY Cargo.toml Cargo.lock ./
COPY .cargo/config.toml ./.cargo/config.toml

COPY crates/app/Cargo.toml      ./crates/app/
COPY crates/frontend/Cargo.toml ./crates/frontend/
COPY crates/server/Cargo.toml   ./crates/server/
COPY crates/api-cli/Cargo.toml  ./crates/api-cli/
COPY crates/kernel/Cargo.toml   ./crates/kernel/
COPY crates/protocol/Cargo.toml ./crates/protocol/
COPY crates/renderer/Cargo.toml ./crates/renderer/
COPY crates/worker/Cargo.toml   ./crates/worker/

# ---- 2) 为所有 crate 生成最小占位源码，否则 cargo 解析 workspace 会报 no targets ----
RUN mkdir -p \
        crates/app/src \
        crates/frontend/src \
        crates/server/src \
        crates/api-cli/src \
        crates/kernel/src \
        crates/protocol/src \
        crates/renderer/src \
        crates/worker/src \
    && touch \
        crates/app/src/lib.rs \
        crates/frontend/src/lib.rs \
        crates/server/src/lib.rs \
        crates/server/src/main.rs \
        crates/api-cli/src/lib.rs \
        crates/api-cli/src/main.rs \
        crates/kernel/src/lib.rs \
        crates/protocol/src/lib.rs \
        crates/renderer/src/lib.rs \
        crates/worker/src/lib.rs

# ---- 3) 下载依赖（占位文件让 cargo 能解析出每个成员的 target） ----
RUN cargo fetch

# ---- 4) 复制真正需要编译的源码与静态资源（覆盖上面的占位文件） ----
COPY crates/app      ./crates/app
COPY crates/frontend ./crates/frontend
COPY crates/server   ./crates/server
COPY assets          ./assets

# ---- 5) 构建（server 二进制 -> target/release/server，站点 -> target/site） ----
RUN cargo leptos build --release

# ================= 运行阶段（Alpine） =================
FROM alpine:3.21

RUN apk add --no-cache ca-certificates tzdata \
    && addgroup -S asterpi \
    && adduser -S asterpi -G asterpi

WORKDIR /app

COPY --from=builder /build/target/release/server /app/server
COPY --from=builder /build/target/site            /app/site

ENV LEPTOS_SITE_ROOT=/app/site \
    LEPTOS_SITE_ADDR=0.0.0.0:3000 \
    LEPTOS_RELOAD_PORT=3001

EXPOSE 3000

USER asterpi

CMD ["/app/server"]